{
    "version": "v1",
    "classifier_version": 2,
    "brackets": [
        {
            "id": "flagship",
            "display_name": "Flagship",
            "display_order": 1,
            "intent": "2024+ top-end CPUs -- the fastest silicon currently shipping. Apple\nM3/M4 Max + Ultra, Ryzen 9 9000-series, Intel Core Ultra 9 200-series,\nThreadripper 7000-series, Snapdragon X Elite.",
            "examples": [
                "Apple M3 Max",
                "Apple M4 Ultra",
                "AMD Ryzen 9 9950X3D",
                "Intel Core Ultra 9 285K",
                "AMD Ryzen Threadripper 7980X",
                "Snapdragon X Elite"
            ],
            "patterns": [
                "ryzen\\s*9\\s*99[0-9]{2}",
                "ryzen\\s*threadripper\\s*7\\d{3}",
                "core\\s*ultra\\s*9\\s*2",
                "core\\s*i9-1[5-9]\\d{3}",
                "apple\\s*m[34]\\s*(max|ultra)",
                "snapdragon\\s*x\\s*elite"
            ]
        },
        {
            "id": "high-end",
            "display_name": "High-end",
            "display_order": 2,
            "intent": "2022-2024 high-end CPUs. Ryzen 9 7000-series + 7800-series, Intel Core\ni9-13xxx/14xxx Raptor Lake, Apple M2/M3 Pro and Max, Threadripper\n5000-6000 series.",
            "examples": [
                "AMD Ryzen 9 7950X",
                "AMD Ryzen 9 7800X3D",
                "Intel Core i9-13900K",
                "Intel Core i9-14900K",
                "Apple M2 Pro",
                "Apple M3"
            ],
            "patterns": [
                "ryzen\\s*9\\s*79[0-9]{2}",
                "ryzen\\s*9\\s*78[0-9]{2}",
                "core\\s*i9-1[34]\\d{3}",
                "apple\\s*m[23]\\s*(max|pro)?",
                "ryzen\\s*threadripper\\s*[56]\\d{3}"
            ]
        },
        {
            "id": "mid-range",
            "display_name": "Mid-range",
            "display_order": 3,
            "intent": "2019-2022 mainstream + mid-tier CPUs. Ryzen 5000-series + 3000-series\n(Zen2), Intel Core i5/i7/i9 11th-gen Tiger Lake + 12th-gen Alder Lake,\nApple M1 in all variants.",
            "examples": [
                "AMD Ryzen 7 5800X",
                "Intel Core i7-11700K",
                "Intel Core i5-12400",
                "Apple M1",
                "Apple M1 Pro"
            ],
            "patterns": [
                "ryzen\\s*[579]\\s*5[0-9]{3}",
                "core\\s*i[579]-1[12]\\d{3}",
                "apple\\s*m1",
                "ryzen\\s*[579]\\s*3[0-9]{3}"
            ]
        },
        {
            "id": "older",
            "display_name": "Older",
            "display_order": 4,
            "intent": "2015-2019 era CPUs. First two Zen generations (Ryzen 1xxx + 2xxx),\nIntel Core 6th through 9th gen Skylake -> Coffee Lake i5/i7/i9.",
            "examples": [
                "AMD Ryzen 5 2600",
                "AMD Ryzen 5 1600",
                "Intel Core i7-7700K",
                "Intel Core i7-6700K"
            ],
            "patterns": [
                "ryzen\\s*[579]\\s*2[0-9]{3}",
                "ryzen\\s*[579]\\s*1[0-9]{3}",
                "core\\s*i[579]-[789]\\d{3}",
                "core\\s*i[579]-6\\d{3}"
            ]
        },
        {
            "id": "legacy",
            "display_name": "Legacy",
            "display_order": 5,
            "intent": "Pre-2015 CPUs. Intel Core 2nd/3rd/4th/5th gen Sandy/Ivy/Haswell/\nBroadwell i3/i5/i7, Core 2 era, AMD pre-Ryzen (Phenom II / Athlon II /\nFX). These still work fine for dedup; just slower per-thread.",
            "examples": [
                "Intel Core i7-3770K",
                "Intel Core i7-2600K",
                "Intel Core i5-5250U",
                "Intel Core 2 Duo E8400",
                "AMD Phenom II X4 965",
                "AMD FX-8350"
            ],
            "patterns": [
                "core\\s*i[357]-[2345]\\d{3}",
                "core\\s*2\\s*(duo|quad)",
                "phenom|athlon\\s*ii|fx-"
            ]
        }
    ]
